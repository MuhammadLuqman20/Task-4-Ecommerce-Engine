# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB Atlas URI or local MongoDB instance (e.g., mongodb://127.0.0.1:27017/ecommerce_db)
# If left blank or unreachable, system automatically boots an in-memory MongoDB instance for seamless testing.
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# JWT Secret & Expiry
JWT_SECRET=super_secret_jwt_key_internship_task_4_replace_in_production
JWT_EXPIRES_IN=7d

# Stripe Test Credentials (Get free test keys at https://dashboard.stripe.com/test/apikeys)
# Format: sk_test_... and pk_test_...
STRIPE_SECRET_KEY=sk_test_51MockKeyReplaceWithYourTestSecretKeyForLiveCharges
STRIPE_WEBHOOK_SECRET=whsec_mockWebhookSecretReplaceWithStripeCliSecret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
